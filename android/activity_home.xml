<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp"> <!-- Added padding for navigation buttons -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Premium Header -->
                <View
                    android:id="@+id/homeHeader"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="@drawable/bg_home_header"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tinkl - Learn With Buddy 🚀"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/homeGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hello! 👋"
                            android:textColor="#DBEAFE"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <Button
                            android:id="@+id/homeProfileBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:backgroundTint="#FFFFFF"
                            android:text="PROFILE"
                            android:textColor="#2563EB"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp" />

                        <Button
                            android:id="@+id/btnShareApp"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#44FFFFFF"
                            android:text="SHARE APP"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <!-- FIRST ROW OF CARDS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 1. TEXT BUDDY -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardTextChat"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_blue"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💬" android:textSize="44sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Text Buddy" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 2. AUDIO BUDDY -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAudioCall"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_green"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📞" android:textSize="44sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio Buddy" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- MIDDLE AD SLOT -->
                <LinearLayout
                    android:id="@+id/homeAdContainerMid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginVertical="12dp"
                    android:minHeight="50dp" />

                <!-- SECOND ROW OF CARDS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <!-- 3. VIDEO BUDDY -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardVideoCall"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_orange"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎥" android:textSize="44sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video Buddy" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 4. DAILY VOCAB -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardVocab"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_gradient_purple"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📚" android:textSize="44sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily Vocab" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Learn Words" android:textColor="#F3E8FF" android:textSize="10sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <Button
                    android:id="@+id/homeSubBtn"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#0F172A"
                    android:text="👑 UPGRADE TO VIP"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="24dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnTelegram"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Join Telegram"
                        android:backgroundTint="#0088cc"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="12dp" />

                    <Button
                        android:id="@+id/btnFeedback"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Feedback"
                        android:backgroundTint="#10B981"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>