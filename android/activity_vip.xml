<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <View
        android:id="@+id/vipHeader"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_home_header"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnVipBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/vipTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👑 TINKL Premium"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/vipSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unlock Unlimited Matches &amp; Exclusive Filters"
        android:textColor="#E2E8F0"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/vipTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/vipHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/plansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Monthly -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/titleMonthly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Starter Monthly" android:textColor="#64748B" android:textStyle="bold" />
                        <TextView android:id="@+id/badgeMonthly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAVE 70%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="#EF4444" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/priceOfferMonthly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹29" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:id="@+id/priceOriginalMonthly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹99" android:textColor="#94A3B8" android:textSize="14sp" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Unlimited Matches\n• No Rewarded Ads (Banners visible)" android:textColor="#475569" android:textSize="12sp" android:layout_marginTop="8dp" />
                    <Button android:id="@+id/btnMonthly" android:layout_width="match_parent" android:layout_height="48dp" android:text="SELECT MONTHLY" android:backgroundTint="#2563EB" android:layout_marginTop="12dp" app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3 Months -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#EFF6FF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/title3Month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pro 3-Months" android:textColor="#2563EB" android:textStyle="bold" />
                        <TextView android:id="@+id/badge3Month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAVE 43%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="#EF4444" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/priceOffer3Month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹159" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:id="@+id/priceOriginal3Month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹297" android:textColor="#94A3B8" android:textSize="14sp" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Unlimited Matches\n• COMPLETELY AD-FREE" android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    <Button android:id="@+id/btn3Month" android:layout_width="match_parent" android:layout_height="48dp" android:text="GO PRO" android:backgroundTint="#2563EB" android:layout_marginTop="12dp" app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Yearly -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FDF2F8">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/titleYearly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Elite Yearly (Power User)" android:textColor="#DB2777" android:textStyle="bold" />
                        <TextView android:id="@+id/badgeYearly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAVE 34%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="#DB2777" android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/priceOfferYearly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹550" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:id="@+id/priceOriginalYearly" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹1100" android:textColor="#94A3B8" android:textSize="14sp" android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• Unlimited Matches\n• COMPLETELY AD-FREE" android:textColor="#DB2777" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="8dp" />
                    <Button android:id="@+id/btnYearly" android:layout_width="match_parent" android:layout_height="48dp" android:text="UNLIMITED ACCESS" android:backgroundTint="#DB2777" android:layout_marginTop="12dp" app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment is processed securely via Google Play. Subscription will be activated instantly."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>